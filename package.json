{
  "name": "topofield-monorepo",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "mobile:start": "npm run start --workspace apps/mobile",
    "mobile:android": "npm run android --workspace apps/mobile",
    "mobile:web": "npm run web --workspace apps/mobile",
    "mobile:build-local-android": "powershell -ExecutionPolicy Bypass -File scripts/build-local-android.ps1",
    "backend:dev": "npm run dev --workspace apps/backend",
    "backend:build": "npm run build --workspace apps/backend",
    "verify:pre-apk": "node scripts/verify-pre-apk.mjs",
    "verify:pre-apk:local": "node scripts/verify-pre-apk.mjs --local-only",
    "verify:remote:public": "node scripts/verify-public-contract.mjs",
    "verify:remote:auth": "node scripts/verify-authenticated-contract.mjs",
    "verify:export-artifacts": "node scripts/verify-round-export-artifacts.mjs",
    "test:tooling": "node --test scripts/windows-command.test.mjs scripts/export-output.test.mjs scripts/verify-public-contract.test.mjs scripts/verify-authenticated-contract.test.mjs",
    "verify:local": "node scripts/verify-local.mjs",
    "verify:local:pre-apk": "node scripts/verify-local.mjs --with-pre-apk",
    "docs:check": "node scripts/check-docs.mjs"
  }
}
